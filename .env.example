# Copy to .env and fill in. Never commit .env.
# No REACT_APP_ prefix: these must stay server-side, readable only by api/.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Google Cloud console → APIs & Services → Credentials.
# Enable "Places API (New)" on the project and restrict the key to that API.
GOOGLE_PLACES_API_KEY=

# https://bankaccountdata.gocardless.com → Developers → User secrets.
# This is the regulated provider that brokers access to Revolut and other banks.
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# Public URL of the deployed app, used as the bank redirect target.
# Leave unset locally; Vercel fills VERCEL_URL automatically.
APP_URL=
